<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for Mac Catalyst. iOS sandboxes differently and ignores this. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Without this, Catalyst TCC returns denied for location and the app never even appears in
	     System Settings > Privacy & Security. NSLocationWhenInUseUsageDescription in Info.plist is
	     still required as well. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>

	<!-- serpentine.phfactor.net, and MapKit's own calls. A sandboxed Catalyst app has no network
	     access without it. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
