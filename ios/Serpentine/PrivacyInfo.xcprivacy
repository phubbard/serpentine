<?xml version="1.0" encoding="UTF-8"?>
<!--
  Serpentine's privacy manifest. No tracking, no collected data types: the app talks to
  serpentine.phfactor.net (route planning; the request carries the start point and is never stored
  or logged server-side) and to Apple's own MapKit services, nothing else.

  Required-reason APIs: UserDefaults (@AppStorage for plan preferences), CA92.1.
  Add FileTimestamp C617.1 / DiskSpace E174.1 if saved rides start writing files.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
</dict>
</plist>
