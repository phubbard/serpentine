<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- serpentine-api on axiom. Installed by `make deploy` into ~/Library/LaunchAgents (same pattern as
     ai.lmstudio.server). Listens on :8990 next to GraphHopper on :8989. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.phfactor.serpentine-api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/pfh/serpentine-api/serpentine-api</string>
        <string>-addr</string>
        <string>:8990</string>
        <string>-gh</string>
        <string>http://localhost:8989</string>
        <!-- NREL key lives only on axiom (mode 600); never in the repo. -->
        <string>-nrel-key-file</string>
        <string>/Users/pfh/serpentine-api/nrel.key</string>
        <!-- Open Charge Map key, same rules: axiom only, mode 600 (ADR-022). Without it plans simply
             carry no charger reliability data. -->
        <string>-ocm-key-file</string>
        <string>/Users/pfh/serpentine-api/ocm.key</string>
        <!-- The country's public chargers, fetched once a day instead of once a plan (ADR-028). -->
        <string>-stations-file</string>
        <string>/Users/pfh/serpentine-api/stations.json</string>
        <!-- Hourly operational counters, so a deploy doesn't erase the week (ADR-027). Aggregates
             only; open it with sqlite3 on axiom. -->
        <string>-stats-db</string>
        <string>/Users/pfh/serpentine-api/stats.db</string>
        <!-- Map tiles for the /v1/ test page, fetched once from OSM and cached here. -->
        <string>-tile-cache</string>
        <string>/Users/pfh/serpentine-api/tiles</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/pfh/serpentine-api/logs/serpentine-api.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pfh/serpentine-api/logs/serpentine-api.log</string>
</dict>
</plist>
