# serpentine.phfactor.net site block for /etc/caddy/Caddyfile on webserver (Pi 5); then
# `sudo systemctl reload caddy`. DNS and cert are in place (2026-09-18).
#
# No auth, by decision (2026-09-18): the app will talk to this host directly and there are no
# accounts. What keeps it cheap is the path allowlist: only what the phone needs reaches axiom.
# /maps (GraphHopper UI), /spt (~500 KB responses), /isochrone (~1.3 s CPU), /mvt and everything
# else stay LAN-only at http://axiom:8989.

serpentine.phfactor.net {
	encode zstd gzip
	log {
		output file /var/log/caddy/serpentine.log
	}

	# serpentine-api: what the app uses.
	handle /v1/* {
		reverse_proxy axiom.phfactor.net:8990 {
			transport http {
				read_timeout 90s
			}
		}
	}

	# Raw GraphHopper, for tools/demo_route.py until it moves to /v1. Drop once the app ships.
	@api path /route /info /health /nearest
	handle @api {
		reverse_proxy axiom.phfactor.net:8989 {
			transport http {
				read_timeout 60s
			}
		}
	}

	handle {
		respond "serpentine" 404
	}
}
