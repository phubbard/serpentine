# serpentine.phfactor.net site block for /etc/caddy/Caddyfile on webserver (Pi 5); then
# `sudo systemctl reload caddy`. DNS and cert are in place (2026-09-18).
#
# No auth, by decision (2026-09-18): the app will talk to this host directly and there are no
# accounts. What keeps it cheap is the path allowlist: only what the phone needs reaches axiom.
# /maps (GraphHopper UI), /spt (~500 KB responses), /isochrone (~1.3 s CPU), /mvt and everything
# else stay LAN-only at http://axiom:8989.

serpentine.phfactor.net {
	encode zstd gzip
	# Access log for abuse spotting only (ADR-017): IPs masked to /16 (v4) and /32 (v6), headers
	# dropped, tile paths (which are map locations) collapsed, 30 days' retention. Plan request
	# bodies (start points) are never logged by Caddy or by serpentine-api.
	log {
		output file /var/log/caddy/serpentine.log {
			roll_keep_for 720h
		}
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>remote_port delete
				request>headers delete
				resp_headers delete
				request>uri regexp ^/v1/tiles/.* /v1/tiles
			}
		}
	}

	# The test page's map (ADR-046): vector tiles, styles, glyphs and sprites from the tile server
	# on this machine (pmtiles on 127.0.0.1:8323, files in /srv/tiles/www), under this site's own
	# name so the page still talks to one host. Answered here, not by serpentine-api: macOS will
	# not let a launchd agent on axiom open a connection to another machine on the LAN. The four
	# shapes below are the same four server/tiles.go relays for a dev run; keep them in step.
	handle_path /v1/tiles/* {
		@tile path_regexp ^/([0-9]|1[0-5])/[0-9]{1,7}/[0-9]{1,7}\.mvt$
		handle @tile {
			rewrite * /planet{path}
			reverse_proxy 127.0.0.1:8323 {
				header_down Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
			}
		}
		# \x20, not a literal space: the Caddyfile splits a matcher's arguments on whitespace.
		@mapfile path_regexp ^/(styles/[a-z]{1,20}\.json|fonts/[A-Za-z0-9%\x20]{1,80}/[0-9]{1,5}-[0-9]{1,5}\.pbf|sprites/v[0-9]/[a-z]{1,20}(@2x)?\.(json|png))$
		handle @mapfile {
			root * /srv/tiles/www
			header Cache-Control "public, max-age=86400"
			@pbf path *.pbf
			header @pbf Content-Type application/x-protobuf
			file_server
		}
		handle {
			respond "serpentine" 404
		}
	}

	# serpentine-api: what the app uses.
	handle /v1/* {
		reverse_proxy axiom.phfactor.net:8990 {
			transport http {
				read_timeout 90s
			}
		}
	}

	# The product page (served by serpentine-api, also at /v1/about).
	handle / {
		reverse_proxy axiom.phfactor.net:8990
	}

	# Raw GraphHopper, for tools/demo_route.py until it moves to /v1. Drop once the app ships.
	@api path /route /info /health /nearest
	handle @api {
		reverse_proxy axiom.phfactor.net:8989 {
			transport http {
				read_timeout 60s
			}
		}
	}

	handle {
		respond "serpentine" 404
	}
}
